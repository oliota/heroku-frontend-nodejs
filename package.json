{
  "name": "heroku-frontend-nodejs",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "heroku:init": "heroku login && heroku create heroku-backend-nodejs --stack heroku-22",
    "heroku:push": "git push heroku main",
    "heroku:open": "heroku open",
    "dev": "node server.js",
    "----": "echo ---------- INSTALL ----------",
    "install:deps": "npm install",
    "-----": "echo ---------- RUN ----------",
    "run": "node server.js",
    "------": "echo ---------- QUALITY ----------",
    "test": "node --test tests/*.test.js",
    "test:adedonha": "node --test tests/adedonha.test.js",
    "test:ui": "playwright test",
    "install": "node scripts/commands.mjs install",
    "build": "node scripts/commands.mjs build",
    "lint": "node scripts/commands.mjs check && prettier --check adedonha server.js scripts tests docs playwright.config.js package.json README.md",
    "format": "prettier --write adedonha server.js scripts tests docs playwright.config.js package.json README.md",
    "debug": "node --inspect server.js",
    "logs": "node scripts/commands.mjs logs",
    "status": "npm ls --depth=0",
    "list": "npm run",
    "help": "npm run list"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10"
  }
}
