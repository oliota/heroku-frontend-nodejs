{
  "name": "heroku-frontend-nodejs",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "heroku:init": "heroku login && heroku create heroku-backend-nodejs --stack heroku-22",
    "heroku:push": "git push heroku main",
    "heroku:open": "heroku open",
    "dev": "node server.js",
    "----": "echo ---------- INSTALL ----------",
    "install:deps": "npm install",
    "-----": "echo ---------- RUN ----------",
    "run": "node server.js",
    "------": "echo ---------- QUALITY ----------",
    "test": "node --check server.js",
    "status": "npm ls --depth=0",
    "list": "npm run",
    "help": "npm run list"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
