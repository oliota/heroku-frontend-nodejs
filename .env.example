ADEDONHA_FIREBASE_API_KEY=
ADEDONHA_FIREBASE_AUTH_DOMAIN=adedonha-stop.firebaseapp.com
ADEDONHA_FIREBASE_PROJECT_ID=adedonha-stop
ADEDONHA_FIREBASE_APP_ID=
ADEDONHA_FIREBASE_MESSAGING_SENDER_ID=
ADEDONHA_FIREBASE_STORAGE_BUCKET=
ADEDONHA_FEEDBACK_URL=
PORT=3000
